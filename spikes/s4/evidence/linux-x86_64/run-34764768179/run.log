$ docker run --rm --label codeagent.spike=s4 --network none --read-only --tmpfs /tmp:rw,size=64m --memory 512m --pids-limit 128 --user 1000:1000 --cap-drop ALL --security-opt no-new-privileges python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea python3 -B -c import time, subprocess
def usage_usec():
    with open('/sys/fs/cgroup/cpu.stat') as f:
        for line in f:
            if line.startswith('usage_usec'):
                return int(line.split()[1])
start_wall = time.time()
start_usage = usage_usec()
procs = [subprocess.Popen(['python3','-B','-c','import time\nt=time.time()\nwhile time.time()-t<4: pass']) for _ in range(4)]
for p in procs: p.wait()
end_wall = time.time()
end_usage = usage_usec()
cores = (end_usage-start_usage)/1_000_000 / (end_wall-start_wall)
print(f'CORES={cores:.3f}')

CORES=1.979


